<!-- Created with Jaspersoft Studio version 6.8.0.final using JasperReports Library version 6.8.0-2ed8dfabb690ff337a5797129f2cd92902b0c87b  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptPeriksaLabPAMCUSMC" pageWidth="595" pageHeight="842" columnWidth="522" leftMargin="56" rightMargin="17" topMargin="20" bottomMargin="20" uuid="5353c680-200b-4a22-8b8e-b6d4e4a440d6">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="norawat" class="java.lang.String"/>
	<parameter name="tglperiksa" class="java.lang.String"/>
	<parameter name="jamperiksa" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select pemeriksaan.no_rawat as noperiksa, reg_periksa.no_rkm_medis as norm, pasien.nm_pasien as namapasien, pasien.jk as jkel, pasien.umur, date_format(pasien.tgl_lahir, '%d-%m-%Y') as lahir,
                perujuk.nm_dokter as pengirim, petugas.nama as petugas, date_format(pemeriksaan.tgl_periksa, '%d-%m-%Y') as tanggal, date_format(pemeriksaan.jam, '%H:%i:%s') as jam, dokter.nm_dokter as penjab,
                concat_ws(', ', pasien.alamat, kelurahan.nm_kel, kecamatan.nm_kec, kabupaten.nm_kab) as alamat, if(pemeriksaan.kd_kamar is null, 'Poli', 'Kamar') as kamar,
                if(pemeriksaan.kd_kamar is null, poliklinik.nm_poli, concat(pemeriksaan.kd_kamar, ', ', ifnull(bangsal.nm_bangsal, ''))) as namakamar,
                concat('Dikeluarkan di ', $P{namars}, ', Kabupaten/Kota ', $P{kotars}, '\nDitandatangani secara elektronik oleh ', dokter.nm_dokter, '\nID ',
                ifnull((select sha1(sidikjari.sidikjari) from sidikjari join pegawai on sidikjari.id = pegawai.id where pegawai.nik = pemeriksaan.kd_dokter limit 1), convert(pemeriksaan.kd_dokter using utf8mb4)),
                '\n', date_format(pemeriksaan.tgl_periksa, '%d-%m-%Y')) as finger,
                concat('Dikeluarkan di ', $P{namars}, ', Kabupaten/Kota ', $P{kotars}, '\nDitandatangani secara elektronik oleh ', petugas.nama, '\nID ',
                ifnull((select sha1(sidikjari.sidikjari) from sidikjari join pegawai on sidikjari.id = pegawai.id where pegawai.nik = pemeriksaan.nip limit 1), convert(pemeriksaan.nip using utf8mb4)),
                '\n', date_format(pemeriksaan.tgl_periksa, '%d-%m-%Y')) as finger2,
                hasil.temp1, hasil.temp2, hasil.temp3, hasil.temp4, hasil.temp5, hasil.temp6
                from (select periksa_lab.no_rawat, periksa_lab.tgl_periksa, periksa_lab.jam, periksa_lab.kd_dokter, periksa_lab.dokter_perujuk, periksa_lab.nip,
                (select kamar_inap.kd_kamar from kamar_inap where kamar_inap.no_rawat = periksa_lab.no_rawat order by kamar_inap.tgl_masuk desc, kamar_inap.jam_masuk desc limit 1) as kd_kamar
                from periksa_lab where periksa_lab.no_rawat = $P{norawat} and periksa_lab.tgl_periksa = $P{tglperiksa} and periksa_lab.jam = $P{jamperiksa} and periksa_lab.kategori = 'PA' limit 1) as pemeriksaan
                join reg_periksa on pemeriksaan.no_rawat = reg_periksa.no_rawat
                join pasien on reg_periksa.no_rkm_medis = pasien.no_rkm_medis
                left join kelurahan on pasien.kd_kel = kelurahan.kd_kel
                left join kecamatan on pasien.kd_kec = kecamatan.kd_kec
                left join kabupaten on pasien.kd_kab = kabupaten.kd_kab
                left join poliklinik on reg_periksa.kd_poli = poliklinik.kd_poli
                left join kamar on pemeriksaan.kd_kamar = kamar.kd_kamar
                left join bangsal on kamar.kd_bangsal = bangsal.kd_bangsal
                left join dokter on pemeriksaan.kd_dokter = dokter.kd_dokter
                left join dokter as perujuk on pemeriksaan.dokter_perujuk = perujuk.kd_dokter
                left join petugas on pemeriksaan.nip = petugas.nip
                join (select periksa_lab.kd_jenis_prw, jns_perawatan_lab.nm_perawatan as temp1, ifnull(detail_periksa_labpa.diagnosa_klinik, '') as temp2, ifnull(detail_periksa_labpa.makroskopik, '') as temp3,
                ifnull(detail_periksa_labpa.mikroskopik, '') as temp4, ifnull(detail_periksa_labpa.kesimpulan, '') as temp5, ifnull(detail_periksa_labpa.kesan, '') as temp6
                from periksa_lab join jns_perawatan_lab on periksa_lab.kd_jenis_prw = jns_perawatan_lab.kd_jenis_prw
                join detail_periksa_labpa on periksa_lab.no_rawat = detail_periksa_labpa.no_rawat and periksa_lab.kd_jenis_prw = detail_periksa_labpa.kd_jenis_prw
                and periksa_lab.tgl_periksa = detail_periksa_labpa.tgl_periksa and periksa_lab.jam = detail_periksa_labpa.jam
                where periksa_lab.no_rawat = $P{norawat} and periksa_lab.tgl_periksa = $P{tglperiksa} and periksa_lab.jam = $P{jamperiksa} and periksa_lab.kategori = 'PA') as hasil
                order by hasil.kd_jenis_prw]]>
	</queryString>
