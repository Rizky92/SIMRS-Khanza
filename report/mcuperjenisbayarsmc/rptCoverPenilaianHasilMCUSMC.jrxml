	<queryString>
		<![CDATA[select
	reg_periksa.no_rkm_medis,
	pasien.nm_pasien,
	if(perusahaan_pasien.nama_perusahaan is null or trim(perusahaan_pasien.nama_perusahaan) = '-', '', trim(perusahaan_pasien.nama_perusahaan)) as nama_perusahaan,
	if(personal_pasien.gambar is null or trim(personal_pasien.gambar) = '' or trim(personal_pasien.gambar) = 'pages/upload/', '', trim(personal_pasien.gambar)) as gambar
from reg_periksa
inner join pasien on reg_periksa.no_rkm_medis = pasien.no_rkm_medis
left join personal_pasien on pasien.no_rkm_medis = personal_pasien.no_rkm_medis
left join perusahaan_pasien on pasien.perusahaan_pasien = perusahaan_pasien.kode_perusahaan
where reg_periksa.no_rawat = $P{norawat}]]>
	</queryString>
