	<parameter name="norawat" class="java.lang.String"/>
	<parameter name="logobytes" class="byte[]" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{logo} == null ? null : net.sf.jasperreports.engine.util.JRLoader.loadBytes($P{logo})]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select 1 as urutan, 'MCU' as jenis, null as tgl_periksa, null as jam, null as noorder from penilaian_mcu where penilaian_mcu.no_rawat = $P{norawat}
                union all
                select distinct 2, 'PK', date_format(periksa_lab.tgl_periksa, '%Y-%m-%d'), date_format(periksa_lab.jam, '%H:%i:%s'),
                (select permintaan_lab.noorder from permintaan_lab where permintaan_lab.no_rawat = periksa_lab.no_rawat and permintaan_lab.tgl_hasil = periksa_lab.tgl_periksa and permintaan_lab.jam_hasil = periksa_lab.jam limit 1)
                from periksa_lab where periksa_lab.no_rawat = $P{norawat} and periksa_lab.kategori = 'PK'
                union all
                select distinct 3, 'PA', date_format(periksa_lab.tgl_periksa, '%Y-%m-%d'), date_format(periksa_lab.jam, '%H:%i:%s'),
                (select permintaan_labpa.noorder from permintaan_labpa where permintaan_labpa.no_rawat = periksa_lab.no_rawat and permintaan_labpa.tgl_hasil = periksa_lab.tgl_periksa and permintaan_labpa.jam_hasil = periksa_lab.jam limit 1)
                from periksa_lab where periksa_lab.no_rawat = $P{norawat} and periksa_lab.kategori = 'PA'
                union all
                select distinct 4, 'MB', date_format(periksa_lab.tgl_periksa, '%Y-%m-%d'), date_format(periksa_lab.jam, '%H:%i:%s'),
                (select permintaan_labmb.noorder from permintaan_labmb where permintaan_labmb.no_rawat = periksa_lab.no_rawat and permintaan_labmb.tgl_hasil = periksa_lab.tgl_periksa and permintaan_labmb.jam_hasil = periksa_lab.jam limit 1)
                from periksa_lab where periksa_lab.no_rawat = $P{norawat} and periksa_lab.kategori = 'MB'
                union all
                select distinct 5, 'RAD', date_format(periksa_radiologi.tgl_periksa, '%Y-%m-%d'), date_format(periksa_radiologi.jam, '%H:%i:%s'), null
                from periksa_radiologi where periksa_radiologi.no_rawat = $P{norawat}
                order by urutan, tgl_periksa, jam]]>
	</queryString>
