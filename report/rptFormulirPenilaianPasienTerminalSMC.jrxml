  <textElement verticalAlignment="Top"><font fontName="Tahoma" size="9"/><paragraph lineSpacing="Single"/></textElement>
  <textFieldExpression><![CDATA["8. Kebutuhan layanan alternatif (Rujuk) :     " + ("Tidak".equals($F{layanan_alternatif}) ? "[X] " : "[   ] ") + "Tidak     " + ("Ya".equals($F{layanan_alternatif}) ? "[X] " : "[   ] ") + "Ya" + ", Kemana : " + ($F{layanan_alternatif_tujuan} == null ? "" : $F{layanan_alternatif_tujuan})]]></textFieldExpression>
</textField>
