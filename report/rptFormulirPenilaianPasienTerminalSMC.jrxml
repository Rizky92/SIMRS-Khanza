<textField isStretchWithOverflow="true" isBlankWhenNull="true">
  <reportElement positionType="Float" x="15" y="44" width="533" height="13" uuid="f36ab413-a9a2-4443-96e8-5a3d11245049"/>
  <textElement verticalAlignment="Top"><font fontName="Tahoma" size="9"/><paragraph lineSpacing="Single"/></textElement>
  <textFieldExpression><![CDATA["6.2 Bagaimana rencana perawatan selanjutnya : " + ($F{rencana_perawatan} == null ? "" : $F{rencana_perawatan})]]></textFieldExpression>
</textField>
<textField isStretchWithOverflow="true" isBlankWhenNull="true">
  <reportElement positionType="Float" x="15" y="58" width="533" height="13" uuid="e2a656d2-ed6a-48d0-8c0b-569c2fee4446"/>
  <textElement verticalAlignment="Top"><font fontName="Tahoma" size="9"/><paragraph lineSpacing="Single"/></textElement>
  <textFieldExpression><![CDATA["6.3 Bila pasien dirawat di rumah, apakah lingkungan sudah dipersiapkan : " + ($F{lingkungan_siap} == null ? "" : $F{lingkungan_siap})]]></textFieldExpression>
</textField>
<textField isStretchWithOverflow="true" isBlankWhenNull="true">
  <reportElement positionType="Float" x="30" y="72" width="518" height="13" uuid="9453e653-2f0f-48f3-b264-7ef54c8e3709"/>
  <textElement verticalAlignment="Top"><font fontName="Tahoma" size="9"/><paragraph lineSpacing="Single"/></textElement>
  <textFieldExpression><![CDATA["Jika Ya, apakah mampu merawat pasien di rumah : " + ($F{mampu_merawat} == null ? "" : $F{mampu_merawat}) + "     Oleh : " + ($F{mampu_merawat_oleh} == null ? "" : $F{mampu_merawat_oleh})]]></textFieldExpression>
</textField>
<textField isStretchWithOverflow="true" isBlankWhenNull="true">
  <reportElement positionType="Float" x="30" y="86" width="518" height="13" uuid="a03dde4b-df72-40e7-94dd-5c56f0d34eb8"/>
  <textElement verticalAlignment="Top"><font fontName="Tahoma" size="9"/><paragraph lineSpacing="Single"/></textElement>
  <textFieldExpression><![CDATA["Jika Tidak, apakah perlu difasilitasi RS (Home Care) : " + ($F{perlu_home_care} == null ? "" : $F{perlu_home_care})]]></textFieldExpression>
</textField>
</band>
